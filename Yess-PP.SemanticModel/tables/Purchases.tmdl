		lineageTag: a7176019-21c5-41c8-a200-ef9093d0622a
		summarizeBy: none
		sourceColumn: Product

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: double
		lineageTag: 13158627-8c46-46b7-b8fb-2bdf65b84fca
		summarizeBy: sum
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Cost Price'
		dataType: double
		formatString: 0
		lineageTag: cfaee216-98af-4ac4-99c6-633c969a75bd
		summarizeBy: sum
		sourceColumn: Cost Price

		annotation SummarizationSetBy = Automatic

	column 'Supplier Type'
		dataType: string
		lineageTag: b9e15d7f-7f28-4cf1-bfd8-ee052a650952
