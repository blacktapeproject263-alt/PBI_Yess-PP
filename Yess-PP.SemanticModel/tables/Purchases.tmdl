	partition Purchases-b8548697-e690-4719-be70-93f3c53fd1ab = m
		mode: import
		queryGroup: 'Purchases Group'
		source =
				let
				    Source = Table.Combine({#"PurchasesOld System", PurchasesNewSystem}),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Quantity", type number}, {"Cost Price", type number}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

