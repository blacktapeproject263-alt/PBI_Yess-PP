/// Таблица фактов закупки и перемещения товаров поставщиками по складам и магазинам.
table Purchases
	lineageTag: 9bf287e5-6a72-4971-bd3a-4baca22f9ab3

	/// Общее количество закупленного товара.
	measure 'Purchase Quantity' = sum(Purchases[Quantity])
		lineageTag: 8efec326-1303-45a8-bd27-8881b07978c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Суммарная стоимость закупленных товаров по себестоимости закупки.
	measure Продажа = SUMX(Purchases, Purchases[Cost Price]*Purchases[Quantity])
		lineageTag: 85e70a18-6e54-4e5c-83a9-0d67e97d76b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Invoice #'
		dataType: int64
		formatString: 0
		lineageTag: 172e744c-4fca-43f2-b108-e67c01e1ac9b
		summarizeBy: sum
		sourceColumn: Invoice #

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: Long Date
		lineageTag: f6204a74-d91a-4587-8bde-c5bd99842359
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Operation Type (purchase / relocation)'
		dataType: string
		lineageTag: 3f51fe36-54ca-4f8d-ae31-23e1b7c78f75
		summarizeBy: none
		sourceColumn: Operation Type (purchase / relocation)

		annotation SummarizationSetBy = Automatic

	column Product
