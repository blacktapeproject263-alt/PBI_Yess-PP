		dataType: string
		lineageTag: f9f4162c-fbaa-4644-8bb1-243af5468f32
		summarizeBy: none
		sourceColumn: Spending Category

		annotation SummarizationSetBy = Automatic

	column 'Planned Cost'
		dataType: double
		lineageTag: 597fcffb-79da-4de9-8987-f030f2bf75b6
		summarizeBy: sum
