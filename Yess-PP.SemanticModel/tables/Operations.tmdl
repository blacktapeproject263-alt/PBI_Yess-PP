/// Фактические и плановые операционные расходы по магазинам и категориям затрат.
table Operations
	lineageTag: dc92efc2-3f20-4178-91de-4e5d6e1061f2

	/// Фактические операционные расходы магазинов.
	measure '1.ActualCost' = SUM(Operations[Actual Cost])
		lineageTag: 8f89f1c2-61ba-4192-97da-e789883c3aaa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Плановые операционные расходы магазинов.
	measure '2.PlannedCost' = SUM(Operations[Planned Cost])
		lineageTag: 0e46e72c-524f-4bab-af3d-dcb1a2486b0f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Процент освоения операционного бюджета (факт к плану).
	measure '3.ActualCost%' = ```
			[1.ActualCost]/[2.PlannedCost] 
			```
		formatString: 0%;-0%;0%
		lineageTag: 011fab59-08b3-4c49-a3af-b60f9ccc75ee

		changedProperty = FormatString

	/// Чистая маржа: валовая прибыль за вычетом операционных расходов.
	measure '4.NetMargin' = Sales[4. Sales]-Sales[5.COGS] - Operations[1.ActualCost]
		lineageTag: 44d4f6dc-26d1-45a0-8462-35aeab6ce055

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Чистая рентабельность продаж (%): отношение чистой маржи к выручке.
	measure '5.MarginNet%' = [4.NetMargin]/Sales[4. Sales]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 44673896-f901-4b69-9d27-a9cdbc094071

		changedProperty = FormatString

	column Date
		dataType: dateTime
		formatString: Long Date
		lineageTag: d6c9a932-f2b1-4bdb-8618-7de6b9e2fd3a
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Store
		dataType: int64
		formatString: 0
		lineageTag: 777ea43b-3581-48fd-bdfd-222cd159fc7c
		summarizeBy: none
		sourceColumn: Store

		annotation SummarizationSetBy = Automatic

